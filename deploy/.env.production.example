# Copy to .env.production on EC2 and fill in values. Do not commit real values.

# RDS MySQL (from AWS RDS console)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_USER=boostflash
DB_PASSWORD=your-db-password
DB_NAME=boostflashcards

# App URLs (use https://your-domain.com or https://EC2-elastic-IP after HTTPS)
SERVER_URL=https://your-app-domain.com
FRONTEND_URL=https://your-app-domain.com

# Backend
JWT_SECRET=your-long-random-jwt-secret
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
